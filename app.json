{
  "expo": {
    "name": "Yadhavv Life Manager",
    "slug": "lifemanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0F",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "android": {
      "package": "com.yadhavv.lifemanager",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#C9A84C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "lifeos-placeholder"
      }
    }
  }
}
